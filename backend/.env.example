# Azure AI Foundry
AZURE_AI_PROJECT_CONNECTION_STRING=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_DEPLOYMENT_FALLBACK=gpt-4.1-mini

# Application
APP_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173

# Diagram execution
DIAGRAM_EXEC_TIMEOUT_SECONDS=30
DIAGRAM_EXEC_MAX_MEMORY_MB=512
DIAGRAM_STORAGE_DIR=./data/diagrams
